<?xml version="1.0" encoding="utf-8"?>
<!-- This is openbox right click menu config file. -->
<openbox_menu xmlns="http://openbox.org/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://openbox.org/                 file:///usr/share/openbox/menu.xsd">
	<menu id="root-menu" label="Openbox 3">
		<item label="Terminal">
			<action name="Execute">
				<execute>x-terminal-emulator</execute>
			</action>
		</item>
		<item label="Search">
			<action name="Execute">
				<execute>rofi -show run -m -1</execute>
			</action>
		</item>
		<item label="FireFox">
			<action name="Execute">
				<execute>firefox</execute>
			</action>
		</item>
		<!-- This requires the presence of the 'openbox-menu' package to work -->
		<menu id="/Debian"/>
		<separator/>
		<menu execute="/usr/bin/obamenu" id="applications-menu" label="Applications"/>
		<menu id="root-menu-881936" label="Styles">
			<item label="Obmenu">
				<action name="Execute">
					<execute>obmenu</execute>
				</action>
			</item>
			<item label="Obconf">
				<action name="Execute">
					<execute>obconf</execute>
				</action>
			</item>
			<item label="Lxappearance">
				<action name="Execute">
					<execute>lxappearance</execute>
				</action>
			</item>
		</menu>
		<menu id="root-menu-283413" label="Shorcuts">
			<item label="Xstartup">
				<action name="Execute">
					<execute>gedit ~/.vnc/xstartup</execute>
				</action>
			</item>
			<item label="AutoStart">
				<action name="Execute">
					<execute>gedit ~/.config/openbox/autostart</execute>
				</action>
			</item>
		</menu>
		<separator/>
		<item label="Loguot">
			<action name="Execute">
				<execute>openbox --exit</execute>
			</action>
		</item>
		<item label="Reboot">
			<action name="Execute">
				<execute>reboot</execute>
			</action>
		</item>
		<item label="Shutdown">
			<action name="Execute">
				<execute>shutdown -h now</execute>
			</action>
		</item>
	</menu>
</openbox_menu>
